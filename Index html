            // generate order book rows based on current price
            function updateOrderBook() {
                // asks (higher than current price)
                const asks = [];
                for (let i = 0; i < 5; i++) {
                    const price = currentPrice + (i+1) * 0.9 + Math.random() * 0.8;
                    const size = (Math.random() * 4 + 0.2).toFixed(2);
                    asks.push({ price: price, size: size });
                }
                // bids (lower)
                const bids = [];
                for (let i = 0; i < 5; i++) {
                    const price = currentPrice - (i+1) * 0.8 - Math.random() * 0.7;
                    const size = (Math.random() * 4 + 0.2).toFixed(2);
                    bids.push({ price: price, size: size });
                }

                // sort asks ascending (lowest first)
                asks.sort((a,b) => a.price - b.price);
                bids.sort((a,b) => b.price - a.price);

                // render asks
                asksContainer.innerHTML = asks.map((ask, idx) => {
                    const total = (ask.price * ask.size).toFixed(2);
                    const widthPercent = Math.min(100, (ask.size / 5) * 100);
                    return `<div class="order-row">
                        <span class="order-price ask">${formatPrice(ask.price)}</span>
                        <span class="order-size">${ask.size}</span>
                        <span class="order-total">$${formatNumber(ask.price * ask.size)}</span>
                        <div class="order-bar ask-bar" style="width: ${widthPercent}%;"></div>
                    </div>`;
                }).join('');

                // render bids
                bidsContainer.innerHTML = bids.map(bid => {
                    const widthPercent = Math.min(100, (bid.size / 5) * 100);
                    return `<div class="order-row">
                        <span class="order-price bid">${formatPrice(bid.price)}</span>
                        <span class="order-size">${bid.size}</span>
                        <span class="order-total">$${formatNumber(bid.price * bid.size)}</span>
                        <div class="order-bar" style="width: ${widthPercent}%;"></div>
                    </div>`;
                }).join('');
            }

