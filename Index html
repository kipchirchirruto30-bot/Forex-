<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QuantEdge · Trading Dashboard</title>
    <!-- Fonts & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: #0b0e14;
            font-family: 'Inter', sans-serif;
            color: #e9edf2;
            padding: 16px;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* main dashboard card */
        .dashboard {
            max-width: 1440px;
            width: 100%;
            background: #13171f;
            border-radius: 28px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8), inset 0 1px 2px rgba(255, 255, 255, 0.03);
            padding: 24px 28px 28px;
            border: 1px solid #2a2f3a;
            transition: all 0.2s;
        }

        /* ========== HEADER ========== */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 28px;
            flex-wrap: wrap;
            gap: 16px;
        }

        .logo-area {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo-icon {
            background: linear-gradient(145deg, #2f6bff, #1a4ed6);
            width: 40px;
            height: 40px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            box-shadow: 0 8px 16px -4px rgba(47, 107, 255, 0.3);
        }

        .logo-text {
            font-size: 22px;
            font-weight: 700;
            letter-spacing: -0.5px;
            background: linear-gradient(135deg, #ffffff, #b0c4ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .balance-chip {
            background: #1b2029;
            padding: 10px 20px;
            border-radius: 60px;
            font-size: 15px;
            font-weight: 500;
            border: 1px solid #2e3542;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .balance-chip i {
            color: #4a8eff;
            font-size: 18px;
        }

        .balance-chip .balance-amount {
            font-weight: 700;
            color: #fff;
            letter-spacing: 0.3px;
        }

        .balance-chip .balance-label {
            color: #7b8498;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .avatar {
            width: 44px;
            height: 44px;
            border-radius: 14px;
            background: linear-gradient(145deg, #242b37, #181d26);
            border: 1px solid #38404e;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #d0d9e9;
            font-weight: 600;
            font-size: 16px;
            cursor: pointer;
            transition: 0.15s;
        }

        .avatar:hover {
            border-color: #4a8eff;
            background: #1c2330;
        }

        /* ========== MAIN GRID ========== */
        .main-grid {
            display: grid;
            grid-template-columns: 1fr 320px;
            gap: 24px;
            margin-bottom: 24px;
        }

        /* chart card */
        .chart-card {
            background: #0f131b;
            border-radius: 24px;
            padding: 18px 20px 20px;
            border: 1px solid #242b36;
            box-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.02);
        }

        .chart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
        }

        .pair-info {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .pair-icon {
            width: 36px;
            height: 36px;
            background: #1c2532;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .pair-name {
            font-weight: 600;
            font-size: 18px;
        }

        .pair-name span {
            color: #7b8498;
            font-weight: 400;
            font-size: 14px;
            margin-left: 6px;
        }

        .price-badge {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .price {
            font-size: 24px;
            font-weight: 700;
            letter-spacing: -0.3px;
        }

        .change {
            background: #1e332a;
            color: #2ad48a;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .change.negative {
            background: #331e20;
            color: #f25c5c;
        }

        /* canvas chart */
        .chart-container {
            width: 100%;
            height: 220px;
            position: relative;
            margin-bottom: 6px;
        }

        canvas {
            width: 100%;
            height: 100%;
            display: block;
            border-radius: 8px;
        }

        /* timeframe row */
        .timeframes {
            display: flex;
            gap: 8px;
            margin-top: 14px;
            margin-bottom: 6px;
        }

        .tf-btn {
            background: transparent;
            border: none;
            color: #7b8498;
            font-weight: 500;
            font-size: 13px;
            padding: 6px 12px;
            border-radius: 30px;
            cursor: pointer;
            transition: 0.15s;
            font-family: 'Inter', sans-serif;
            border: 1px solid transparent;
        }

        .tf-btn:hover {
            color: #d0d9e9;
            background: #1c2330;
        }

        .tf-btn.active {
            background: #1e2a3a;
            color: #fff;
            border-color: #345a9e;
            box-shadow: 0 2px 10px rgba(47, 107, 255, 0.2);
        }

        /* right column: order book & trade */
        .side-panel {
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        .order-book {
            background: #0f131b;
            border-radius: 24px;
            padding: 18px 18px 16px;
            border: 1px solid #242b36;
        }

        .panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
        }

        .panel-header h3 {
            font-size: 15px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #9aa6b9;
        }

        .depth-switch {
            display: flex;
            gap: 4px;
            background: #1a1f29;
            padding: 3px;
            border-radius: 40px;
            font-size: 12px;
            font-weight: 600;
        }

        .depth-switch span {
            padding: 4px 10px;
            border-radius: 30px;
            cursor: pointer;
            color: #7b8498;
        }

        .depth-switch span.active {
            background: #2a3440;
            color: #fff;
        }

        .order-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .order-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 13px;
            font-weight: 500;
            position: relative;
            padding: 5px 4px;
            border-radius: 6px;
            transition: 0.1s;
        }

        .order-row:hover {
            background: #1b222d;
        }

        .order-price.bid {
            color: #2ad48a;
        }

        .order-price.ask {
            color: #f25c5c;
        }

        .order-size {
            color: #cbd2df;
            font-weight: 600;
        }

        .order-total {
            color: #6d7b90;
            font-size: 12px;
            font-weight: 500;
        }

        .order-bar {
            position: absolute;
            right: 0;
            top: 0;
            bottom: 0;
            background: rgba(42, 212, 138, 0.08);
            border-radius: 4px;
            z-index: 0;
        }

        .order-bar.ask-bar {
            background: rgba(242, 92, 92, 0.08);
        }

        .order-row > * {
            position: relative;
            z-index: 2;
        }

        .divider {
            height: 1px;
            background: #242b36;
            margin: 12px 0;
        }

        .spread-info {
            display: flex;
            justify-content: space-between;
            font-size: 12px;
            color: #7b8498;
            padding: 6px 4px;
            font-weight: 500;
        }

        /* trade panel */
        .trade-panel {
            background: #0f131b;
            border-radius: 24px;
            padding: 18px;
            border: 1px solid #242b36;
        }

        .trade-tabs {
            display: flex;
            gap: 6px;
            background: #1a1f29;
            padding: 4px;
            border-radius: 40px;
            margin-bottom: 18px;
        }

        .trade-tab {
            flex: 1;
            text-align: center;
            padding: 8px 0;
            font-size: 14px;
            font-weight: 600;
            border-radius: 30px;
            color: #7b8498;
            cursor: pointer;
            transition: 0.15s;
        }

        .trade-tab.active {
            background: #252e3c;
            color: #fff;
            box-shadow: 0 2px 8px rgba(0,0,0,0.4);
        }

        .trade-tab.buy.active {
            background: #1f3a2e;
            color: #2ad48a;
        }

        .trade-tab.sell.active {
            background: #3a2428;
            color: #f25c5c;
        }

        .input-group {
            margin-bottom: 16px;
        }

        .input-group label {
            display: block;
            font-size: 12px;
            font-weight: 600;
            color: #8f9bb0;
            text-transform: uppercase;
            letter-spacing: 0.3px;
            margin-bottom: 6px;
        }

        .input-wrapper {
            display: flex;
            align-items: center;
            background: #1a1f29;
            border-radius: 14px;
            padding: 4px 16px;
            border: 1px solid #2b3340;
            transition: 0.15s;
        }

        .input-wrapper:focus-within {
            border-color: #4a8eff;
            box-shadow: 0 0 0 3px rgba(74, 142, 255, 0.1);
        }

        .input-wrapper input {
            background: transparent;
            border: none;
            color: #fff;
            font-size: 18px;
            font-weight: 600;
            width: 100%;
            padding: 10px 0;
            outline: none;
            font-family: 'Inter', sans-serif;
        }

        .input-wrapper input::placeholder {
            color: #4e5a6e;
            font-weight: 400;
            font-size: 15px;
        }

        .input-suffix {
            color: #7b8498;
            font-weight: 500;
            font-size: 13px;
        }

        .slider-container {
            display: flex;
            gap: 6px;
            margin: 12px 0 18px;
        }

        .slider-btn {
            flex: 1;
            background: #1a1f29;
            border: 1px solid #2b3340;
            color: #9aa6b9;
            padding: 8px 0;
            border-radius: 30px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.1s;
            font-family: 'Inter', sans-serif;
        }

        .slider-btn:hover {
            background: #222b38;
            color: #fff;
        }

        .action-btn {
            width: 100%;
            background: linear-gradient(145deg, #2f6bff, #1e4fd9);
            border: none;
            color: #fff;
            font-weight: 700;
            font-size: 16px;
            padding: 16px 0;
            border-radius: 18px;
            cursor: pointer;
            transition: 0.15s;
            font-family: 'Inter', sans-serif;
            box-shadow: 0 10px 20px -8px rgba(47, 107, 255, 0.4);
            letter-spacing: 0.3px;
        }

        .action-btn:hover {
            background: linear-gradient(145deg, #3e78ff, #2558e0);
            transform: scale(1.01);
        }

        .action-btn.sell-btn {
            background: linear-gradient(145deg, #d63c4a, #b11e2e);
            box-shadow: 0 10px 20px -8px rgba(214, 60, 74, 0.4);
        }

        .action-btn.sell-btn:hover {
            background: linear-gradient(145deg, #e04b59, #c52a3a);
        }

        /* bottom stats row */
        .stats-row {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-top: 24px;
        }

        .stat-card {
            background: #0f131b;
            border-radius: 18px;
            padding: 16px 18px;
            border: 1px solid #242b36;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .stat-label {
            font-size: 12px;
            font-weight: 500;
            color: #7b8498;
            text-transform: uppercase;
            letter-spacing: 0.4px;
        }

        .stat-value {
            font-size: 20px;
            font-weight: 700;
            letter-spacing: -0.3px;
        }

        .stat-value.positive {
            color: #2ad48a;
        }

        .stat-value.negative {
            color: #f25c5c;
        }

        /* responsiveness */
        @media (max-width: 1024px) {
            .main-grid {
                grid-template-columns: 1fr;
            }
            .side-panel {
                flex-direction: row;
                flex-wrap: wrap;
            }
            .order-book, .trade-panel {
                flex: 1 1 280px;
            }
            .stats-row {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 640px) {
            .dashboard {
                padding: 16px;
            }
            .header-actions {
                flex-wrap: wrap;
            }
            .stats-row {
                grid-template-columns: 1fr;
            }
            .side-panel {
                flex-direction: column;
            }
            .price {
                font-size: 20px;
            }
        }

        /* blinking dot live */
        .live-dot {
            display: inline-block;
            width: 8px;
            height: 8px;
            background: #2ad48a;
            border-radius: 50%;
            margin-right: 6px;
            animation: pulse 1.8s infinite;
        }

        @keyframes pulse {
            0% { opacity: 0.6; transform: scale(0.9); }
            50% { opacity: 1; transform: scale(1.2); }
            100% { opacity: 0.6; transform: scale(0.9); }
        }

        .fa-chevron-up, .fa-chevron-down {
            font-size: 11px;
        }
    </style>
</head>
<body>
    <div class="dashboard">
        <!-- HEADER -->
        <div class="header">
            <div class="logo-area">
                <div class="logo-icon"><i class="fas fa-bolt" style="color: white;"></i></div>
                <div class="logo-text">QuantEdge</div>
            </div>
            <div class="header-actions">
                <div class="balance-chip">
                    <i class="fas fa-wallet"></i>
                    <span class="balance-label">Available</span>
                    <span class="balance-amount" id="balanceAmount">$24,580.42</span>
                </div>
                <div class="avatar"><i class="fas fa-user-astronaut"></i></div>
            </div>
        </div>

        <!-- MAIN GRID (chart + side panel) -->
        <div class="main-grid">
            <!-- LEFT: CHART CARD -->
            <div class="chart-card">
                <div class="chart-header">
                    <div class="pair-info">
                        <div class="pair-icon"><i class="fab fa-bitcoin" style="color: #f7931a;"></i></div>
                        <div class="pair-name">BTC/USDT <span>Spot</span></div>
                    </div>
                    <div class="price-badge">
                        <div class="price" id="currentPrice">$63,842.20</div>
                        <div class="change" id="priceChange"><i class="fas fa-chevron-up"></i> 2.34%</div>
                    </div>
                </div>

                <div class="chart-container">
                    <canvas id="priceChart" width="800" height="220"></canvas>
                </div>

                <div class="timeframes">
                    <button class="tf-btn" data-tf="1m">1m</button>
                    <button class="tf-btn" data-tf="5m">5m</button>
                    <button class="tf-btn active" data-tf="15m">15m</button>
                    <button class="tf-btn" data-tf="1h">1h</button>
                    <button class="tf-btn" data-tf="4h">4h</button>
                    <button class="tf-btn" data-tf="1d">1D</button>
                </div>
            </div>

            <!-- RIGHT: ORDER BOOK + TRADE -->
            <div class="side-panel">
                <!-- ORDER BOOK -->
                <div class="order-book">
                    <div class="panel-header">
                        <h3>Order Book</h3>
                        <div class="depth-switch">
                            <span class="active">0.1</span>
                            <span>1.0</span>
                        </div>
                    </div>
                    <div class="order-list" id="orderBookAsks">
                        <!-- ASK rows (red) will be injected via JS, but we add placeholders for design -->
                        <div class="order-row"><span class="order-price ask">63,848.10</span><span class="order-size">1.24</span><span class="order-total">$79,171</span><div class="order-bar ask-bar" style="width: 45%;"></div></div>
                        <div class="order-row"><span class="order-price ask">63,846.50</span><span class="order-size">0.87</span><span class="order-total">$55,540</span><div class="order-bar ask-bar" style="width: 32%;"></div></div>
                        <div class="order-row"><span class="order-price ask">63,845.00</span><span class="order-size">2.10</span><span class="order-total">$134,074</span><div class="order-bar ask-bar" style="width: 78%;"></div></div>
                        <div class="order-row"><span class="order-price ask">63,843.80</span><span class="order-size">0.45</span><span class="order-total">$28,729</span><div class="order-bar ask-bar" style="width: 18%;"></div></div>
                        <div class="order-row"><span class="order-price ask">63,842.90</span><span class="order-size">3.12</span><span class="order-total">$199,189</span><div class="order-bar ask-bar" style="width: 95%;"></div></div>
                    </div>
                    <div class="divider"></div>
                    <div class="spread-info">
                        <span>Spread</span>
                        <span style="color: #cad2df;">$1.20 (0.002%)</span>
                    </div>
                    <div class="divider"></div>
                    <div class="order-list" id="orderBookBids">
                        <!-- BID rows (green) -->
                        <div class="order-row"><span class="order-price bid">63,841.70</span><span class="order-size">0.92</span><span class="order-total">$58,734</span><div class="order-bar" style="width: 35%;"></div></div>
                        <div class="order-row"><span class="order-price bid">63,840.20</span><span class="order-size">1.56</span><span class="order-total">$99,590</span><div class="order-bar" style="width: 58%;"></div></div>
                        <div class="order-row"><span class="order-price bid">63,838.90</span><span class="order-size">2.43</span><span class="order-total">$155,128</span><div class="order-bar" style="width: 82%;"></div></div>
                        <div class="order-row"><span class="order-price bid">63,837.50</span><span class="order-size">0.67</span><span class="order-total">$42,771</span><div class="order-bar" style="width: 22%;"></div></div>
                        <div class="order-row"><span class="order-price bid">63,836.00</span><span class="order-size">4.05</span><span class="order-total">$258,535</span><div class="order-bar" style="width: 100%;"></div></div>
                    </div>
                </div>

                <!-- TRADE PANEL -->
                <div class="trade-panel">
                    <div class="trade-tabs">
                        <div class="trade-tab buy active" id="buyTab">Buy</div>
                        <div class="trade-tab sell" id="sellTab">Sell</div>
                    </div>
                    <div class="input-group">
                        <label>Price</label>
                        <div class="input-wrapper">
                            <input type="text" id="priceInput" value="63,842.20" placeholder="0.00">
                            <span class="input-suffix">USDT</span>
                        </div>
                    </div>
                    <div class="input-group">
                        <label>Amount</label>
                        <div class="input-wrapper">
                            <input type="text" id="amountInput" placeholder="0.00" value="0.25">
                            <span class="input-suffix">BTC</span>
                        </div>
                    </div>
                    <div class="slider-container">
                        <button class="slider-btn" data-percent="25">25%</button>
                        <button class="slider-btn" data-percent="50">50%</button>
                        <button class="slider-btn" data-percent="75">75%</button>
                        <button class="slider-btn" data-percent="100">100%</button>
                    </div>
                    <button class="action-btn" id="tradeActionBtn">Buy BTC</button>
                </div>
            </div>
        </div>

        <!-- BOTTOM STATS -->
        <div class="stats-row">
            <div class="stat-card">
                <span class="stat-label">24h Change</span>
                <span class="stat-value positive" id="stat24hChange">+$1,462.30</span>
            </div>
            <div class="stat-card">
                <span class="stat-label">24h High</span>
                <span class="stat-value">$64,210.50</span>
            </div>
            <div class="stat-card">
                <span class="stat-label">24h Volume</span>
                <span class="stat-value">$1.82B</span>
            </div>
            <div class="stat-card">
                <span class="stat-label">Open Interest</span>
                <span class="stat-value">$342.9M</span>
            </div>
        </div>
    </div>

    <script>
        (function() {
            // ========== REALISTIC PRICE SIMULATION ==========
            let currentPrice = 63842.20;
            const priceDisplay = document.getElementById('currentPrice');
            const priceChangeDiv = document.getElementById('priceChange');
            const balanceAmount = document.getElementById('balanceAmount');
            const stat24hChange = document.getElementById('stat24hChange');
            const priceInput = document.getElementById('priceInput');
            const amountInput = document.getElementById('amountInput');
            const tradeActionBtn = document.getElementById('tradeActionBtn');
            const buyTab = document.getElementById('buyTab');
            const sellTab = document.getElementById('sellTab');

            // balance simulation
            let balance = 24580.42;

            // chart data (20 points)
            let chartData = [63520, 63680, 63620, 63790, 63840, 63810, 63920, 63980, 63870, 63950, 64010, 63980, 64050, 64020, 63990, 64080, 64120, 64060, 64150, 64180];
            
            // canvas
            const canvas = document.getElementById('priceChart');
            const ctx = canvas.getContext('2d');

            // order book dynamic rows
            const asksContainer = document.getElementById('orderBookAsks');
            const bidsContainer = document.getElementById('orderBookBids');

            // functions to format price
            function formatPrice(val) {
                return val.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            function formatNumber(val) {
                return val.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            // draw chart
            function drawChart() {
                const width = canvas.width;
                const height = canvas.height;
                ctx.clearRect(0, 0, width, height);

                // padding
                const padX = 10, padY = 16;
                const plotWidth = width - padX * 2;
                const plotHeight = height - padY * 2;

                const minVal = Math.min(...chartData) * 0.9995;
                const maxVal = Math.max(...chartData) * 1.0005;
                const range = maxVal - minVal;

                // draw grid (subtle)
                ctx.strokeStyle = '#242b36';
                ctx.lineWidth = 1;
                for (let i = 0; i <= 4; i++) {
                    const y = padY + (plotHeight / 4) * i;
                    ctx.beginPath();
                    ctx.moveTo(padX, y);
                    ctx.lineTo(width - padX, y);
                    ctx.strokeStyle = '#1e2530';
                    ctx.stroke();
                }

                // draw gradient line
                const points = chartData.map((val, idx) => {
                    const x = padX + (idx / (chartData.length - 1)) * plotWidth;
                    const y = padY + plotHeight - ((val - minVal) / range) * plotHeight;
                    return { x, y };
                });

                // fill area under curve
                const gradient = ctx.createLinearGradient(0, 0, 0, height);
                gradient.addColorStop(0, 'rgba(47, 107, 255, 0.25)');
                gradient.addColorStop(1, 'rgba(47, 107, 255, 0.0)');
                
                ctx.beginPath();
                ctx.moveTo(points[0].x, points[0].y);
                points.forEach(p => ctx.lineTo(p.x, p.y));
                ctx.lineTo(points[points.length-1].x, height - padY);
                ctx.lineTo(points[0].x, height - padY);
                ctx.closePath();
                ctx.fillStyle = gradient;
                ctx.fill();

                // draw line
                ctx.beginPath();
                ctx.strokeStyle = '#2f6bff';
                ctx.lineWidth = 2.5;
                ctx.lineJoin = 'round';
                ctx.lineCap = 'round';
                points.forEach((p, i) => {
                    if (i === 0) ctx.moveTo(p.x, p.y);
                    else ctx.lineTo(p.x, p.y);
                });
                ctx.stroke();

                // draw last point dot
                const last = points[points.length - 1];
                ctx.beginPath();
                ctx.fillStyle = '#2f6bff';
                ctx.shadowColor = '#2f6bff';
                ctx.shadowBlur = 12;
                ctx.arc(last.x, last.y, 4, 0, Math.PI * 2);
                ctx.fill();
                ctx.shadowBlur = 0;
            }

